# =============================================================================
# BAD CORE API — environment configuration
# Copy this file to `.env` and fill in the values for your setup.
# =============================================================================

# ----------------------------------------------------------------------------
# LLM provider selection
# ----------------------------------------------------------------------------
# Which LLM backend to use for document extraction.
#   gemini -> Google Gemini (default)
#   openai -> any OpenAI-compatible vision endpoint
#             (OpenAI, vLLM, Ollama, LM Studio, Together, Groq, etc.)
LLM_PROVIDER=gemini

# Model name. Leave EMPTY to use the per-provider default:
#   gemini -> gemini-2.5-flash-lite
#   openai -> gpt-4o-mini
# NOTE: the model must be vision-capable (extraction sends an image).
LLM_MODEL=

# --- Gemini credentials (required when LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=your_google_api_key_here

# --- OpenAI-compatible credentials (required when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
# Endpoint base URL. Change this for self-hosted / third-party endpoints,
# e.g. http://localhost:11434/v1 (Ollama) or http://localhost:8000/v1 (vLLM).
OPENAI_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# PostgreSQL connection string. Falls back to a local SQLite file
# (sqlite:///./ktp.db) if unset.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ----------------------------------------------------------------------------
# API authentication
# ----------------------------------------------------------------------------
# Secret required in the `X-API-Key` header to call protected endpoints.
API_KEY=your_secret_api_key_here

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,https://core.badai.tech
